# Files the dev site (Cloudflare Workers static assets) must not upload or serve.
# Same syntax as .gitignore. Pages, images, robots.txt, llms.txt and sitemap.xml still deploy.
.git
.github
.gitignore
*.md
*.py
*.jsonc
ibb_map.json
scripts/
data/
node_modules/

# App Worker source (deployed as the Worker, not as a static file)
worker/
.dev.vars.example
.vscode/
